# Copy to .env for LOCAL development only. Never commit .env (it is git-ignored).
# On Railway, set these in the service's Variables tab instead.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/personal_api
GITHUB_TOKEN=your_github_token_here

# Required for any write (saving sleep/screen time). At least 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value locally than in production. Never paste the real one into GitHub/Vercel.
ADMIN_API_TOKEN=

# Optional: extra dashboard origins allowed to read the API from a browser (comma-separated).
# Leave empty to allow only the Railway dashboard. "*" is not accepted.
# CORS_ORIGINS=http://localhost:3000

# Optional: set to false to turn off the built-in hourly sync (e.g. if you use a Railway Cron service).
# SYNC_SCHEDULER_ENABLED=true
